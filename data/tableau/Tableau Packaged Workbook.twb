              <calculation class='tableau' formula='(SUM([Calculation_2723255432974341]) - SUM([Calculation_2723255433117702])) &#13;&#10;/ ABS(SUM([Calculation_2723255433117702]))' />
            </column>
            <column caption='Month-Year Label' datatype='string' name='[Calculation_2723255418105858]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([Date])) + &quot;-&quot; + RIGHT(&quot;0&quot; + STR(MONTH([Date])), 2)' />
            </column>
            <column caption='Current Year Sales' datatype='real' name='[Calculation_2723255432974341]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Date]) = {MAX(YEAR([Date]))} THEN [Net_Sales] END' />
            </column>
