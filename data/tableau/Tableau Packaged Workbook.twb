        <calculation class='tableau' formula='SUM([Net_Profit]) / SUM([Net_Sales])' />
      </column>
      <column caption='YoY Sales Growth %' datatype='real' name='[Calculation_2723255417987073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_2723255432974341]) - SUM([Calculation_2723255433117702])) &#13;&#10;/ ABS(SUM([Calculation_2723255433117702]))' />
      </column>
      <column caption='Month-Year Label' datatype='string' name='[Calculation_2723255418105858]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(YEAR([Date])) + &quot;-&quot; + RIGHT(&quot;0&quot; + STR(MONTH([Date])), 2)' />
      </column>
      <column caption='Category Performance Tier' datatype='string' name='[Calculation_2723255418241027]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Net_Sales]) &gt;= 100000 THEN &quot;Top Performer&quot;&#13;&#10;ELSEIF SUM([Net_Sales]) &gt;= 50000 THEN &quot;On Target&quot;&#13;&#10;ELSEIF SUM([Net_Sales]) &gt;= 20000 THEN &quot;Below Target&quot;&#13;&#10;ELSE &quot;Needs Attention&quot;&#13;&#10;END' />
      </column>
      <column caption='Parameter-Driven KPI' datatype='real' name='[Calculation_2723255418306564]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[P: Select Region (copy 2)] = &quot;Net Sales&quot; THEN SUM([Net_Sales])&#13;&#10;ELSEIF [Parameters].[P: Select Region (copy 2)] = &quot;Profit&quot; THEN SUM([Net_Profit])&#13;&#10;ELSE SUM([Net_Profit]) / SUM([Net_Sales])&#13;&#10;END' />
      </column>
      <column caption='Current Year Sales' datatype='real' name='[Calculation_2723255432974341]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Date]) = {MAX(YEAR([Date]))} THEN [Net_Sales] END' />
      </column>
      <column caption='Prior Year Sales' datatype='real' name='[Calculation_2723255433117702]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Date]) = {MAX(YEAR([Date]))} - 1 THEN [Net_Sales] END' />
      </column>
